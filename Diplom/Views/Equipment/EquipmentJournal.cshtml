@model List<Diplom.Models.EquipmentJournalModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var equipments = ViewBag.Equipments as List<Diplom.Models.EquipmentModel> ?? new();
    var spareParts = ViewBag.SpareParts as List<Diplom.Models.Warehouses.MaterialLogModel> ?? new();
    var lubricants = ViewBag.Lubricants as List<Diplom.Models.Warehouses.MaterialLogModel> ?? new();
    int newIndex = Model?.Count ?? 0;

    double Stock(int? id, string? category)
    {
        if (!id.HasValue)
            return 0;

        var source = category == "Lubricants" ? lubricants : spareParts;
        return source.FirstOrDefault(x => x.Id == id.Value)?.Quantity ?? 0;
    }
}

<style>
    .select-required-missing {
        border-color: #dc3545 !important;
        background-color: #f8d7da !important;
    }
</style>

<div class="journal-page equipment-journal-page">
    <h3 class="text-center">@Localizer["Equipment Journal"]</h3>

    <div id="equipment-stock-warning" class="alert alert-danger text-center" style="display:none;">
        @Localizer["Not enough material in warehouse."]
    </div>

    <form action="/EquipmentJournal/Save" method="post">
        @Html.AntiForgeryToken()

        <div class="journal-table-wrap equipment-journal-table-wrap">
            <table class="table table-bordered table-sm text-center align-middle journal-table equipment-journal-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Localizer["Equipment"]</th>
                        <th>@Localizer["Work Type"]</th>
                        <th>@Localizer["Date"]</th>
                        <th>@Localizer["Materials"]</th>
                        <th>@Localizer["Quantity"]</th>
                        <th>@Localizer["Working Hours"]</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < (Model?.Count ?? 0); i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <input type="hidden" name="models[@i].Id" value="@Model![i].Id" />

                            <td>
                                <select name="models[@i].EquipmentId" class="form-control" required>
                                    <option value="">-- @Localizer["Select equipment"] --</option>
                                    @foreach (var eq in equipments)
                                    {
                                        <option value="@eq.Id" selected="@(eq.Id == Model[i].EquipmentId)">@eq.Name</option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input name="models[@i].WorkType" value="@Model[i].WorkType" class="form-control" required />
                            </td>

                            <td>
                                <input type="date" name="models[@i].Date" value="@Model[i].Date?.ToString("yyyy-MM-dd")" class="form-control" required />
                            </td>

                            <td class="material-cell">
                                <div class="material-rows" data-row-index="@i">
                                    @if (Model[i].JournalMaterials != null && Model[i].JournalMaterials.Any())
                                    {
                                        @for (int m = 0; m < Model[i].JournalMaterials.Count; m++)
                                        {
                                            var mat = Model[i].JournalMaterials[m];

                                            <div class="material-row mb-1">
                                                <div class="input-group input-group-sm">
                                                    <input type="hidden" name="models[@i].MaterialRowIds_List[@m]" value="@mat.Id" />
                                                    <input type="hidden" name="models[@i].MaterialIds_List[@m]" value="@mat.MaterialId" class="material-id-input" />
                                                    <input type="hidden" name="models[@i].MaterialCategories_List[@m]" value="@mat.MaterialCategory" class="material-category-input" />

                                                    <div class="cascading-select form-control form-control-sm material-select"
                                                         data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)'
                                                         data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)'
                                                         data-selected-category="@mat.MaterialCategory"
                                                         data-selected-item="@mat.MaterialId"
                                                         data-placeholder="@Localizer["Select Material"]"
                                                         data-row-index="@i"
                                                         data-material-index="@m"></div>

                                                    <div class="input-group-append d-flex">
                                                        <button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@i">+</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="@m">×</button>
                                                    </div>
                                                </div>

                                                <input type="hidden" class="material-stock" value="@(Stock(mat.MaterialId, mat.MaterialCategory) + (mat.Quantity ?? 0))" />
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="material-row mb-1">
                                            <div class="input-group input-group-sm">
                                                <input type="hidden" name="models[@i].MaterialRowIds_List[0]" value="0" />
                                                <input type="hidden" name="models[@i].MaterialIds_List[0]" class="material-id-input" />
                                                <input type="hidden" name="models[@i].MaterialCategories_List[0]" class="material-category-input" />

                                                <div class="cascading-select form-control form-control-sm material-select"
                                                     data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)'
                                                     data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)'
                                                     data-selected-category=""
                                                     data-selected-item=""
                                                     data-placeholder="@Localizer["Select Material"]"
                                                     data-row-index="@i"
                                                     data-material-index="0"></div>

                                                <div class="input-group-append d-flex">
                                                    <button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@i">+</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="0">×</button>
                                                </div>
                                            </div>

                                            <input type="hidden" class="material-stock" value="0" />
                                        </div>
                                    }
                                </div>
                            </td>

                            <td class="quantity-cell">
                                <div class="quantity-rows" data-row-index="@i">
                                    @if (Model[i].JournalMaterials != null && Model[i].JournalMaterials.Any())
                                    {
                                        @for (int m = 0; m < Model[i].JournalMaterials.Count; m++)
                                        {
                                            <div class="quantity-row mb-1">
                                                <input type="number" name="models[@i].Quantities_List[@m]" value="@Model[i].JournalMaterials[m].Quantity" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required />
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="quantity-row mb-1">
                                            <input type="number" name="models[@i].Quantities_List[0]" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required />
                                        </div>
                                    }
                                </div>
                            </td>

                            <td>
                                <input name="models[@i].WorkingHours" value="@Model[i].WorkingHours" class="form-control" required />
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td>+</td>
                        <input type="hidden" name="models[@newIndex].Id" value="0" />

                        <td>
                            <select name="models[@newIndex].EquipmentId" class="form-control" required>
                                <option value="" selected>-- @Localizer["Select equipment"] --</option>
                                @foreach (var eq in equipments)
                                {
                                    <option value="@eq.Id">@eq.Name</option>
                                }
                            </select>
                        </td>

                        <td>
                            <input name="models[@newIndex].WorkType" class="form-control" required />
                        </td>

                        <td>
                            <input type="date" name="models[@newIndex].Date" class="form-control" required />
                        </td>

                        <td class="material-cell">
                            <div class="material-rows" data-row-index="@newIndex">
                                <div class="material-row mb-1">
                                    <div class="input-group input-group-sm">
                                        <input type="hidden" name="models[@newIndex].MaterialRowIds_List[0]" value="0" />
                                        <input type="hidden" name="models[@newIndex].MaterialIds_List[0]" class="material-id-input" />
                                        <input type="hidden" name="models[@newIndex].MaterialCategories_List[0]" class="material-category-input" />

                                        <div class="cascading-select form-control form-control-sm material-select"
                                             data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)'
                                             data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)'
                                             data-selected-category=""
                                             data-selected-item=""
                                             data-placeholder="@Localizer["Select Material"]"
                                             data-row-index="@newIndex"
                                             data-material-index="0"></div>

                                        <div class="input-group-append d-flex">
                                            <button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@newIndex">+</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@newIndex" data-material-index="0">×</button>
                                        </div>
                                    </div>

                                    <input type="hidden" class="material-stock" value="0" />
                                </div>
                            </div>
                        </td>

                        <td class="quantity-cell">
                            <div class="quantity-rows" data-row-index="@newIndex">
                                <div class="quantity-row mb-1">
                                    <input type="number" name="models[@newIndex].Quantities_List[0]" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required />
                                </div>
                            </div>
                        </td>

                        <td>
                            <input name="models[@newIndex].WorkingHours" class="form-control" required />
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="equipment-journal-actions mt-3">
            <button type="submit" id="saveButton" class="btn btn-primary">@Localizer["Save"]</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.material-select').forEach(initSelect);

        document.addEventListener('click', function (e) {
            const add = e.target.closest('.add-material-inline');

            if (add) {
                e.preventDefault();
                addRow(add.dataset.rowIndex);
                return;
            }

            const remove = e.target.closest('.remove-material');

            if (remove) {
                e.preventDefault();
                removeRow(remove.dataset.rowIndex, remove.dataset.materialIndex);
            }
        });

        function addRow(rowIndex) {
            const materialRows = document.querySelector(`.material-rows[data-row-index="${rowIndex}"]`);
            const quantityRows = document.querySelector(`.quantity-rows[data-row-index="${rowIndex}"]`);
            const firstSelect = materialRows.querySelector('.material-select');
            const materialIndex = materialRows.querySelectorAll('.material-row').length;
            const materialRow = document.createElement('div');

            materialRow.className = 'material-row mb-1';
            materialRow.innerHTML = `
                <div class="input-group input-group-sm">
                    <input type="hidden" name="models[${rowIndex}].MaterialRowIds_List[${materialIndex}]" value="0" />
                    <input type="hidden" name="models[${rowIndex}].MaterialIds_List[${materialIndex}]" class="material-id-input" />
                    <input type="hidden" name="models[${rowIndex}].MaterialCategories_List[${materialIndex}]" class="material-category-input" />
                    <div class="cascading-select form-control form-control-sm material-select"
                         data-spareparts='${firstSelect.dataset.spareparts}'
                         data-lubricants='${firstSelect.dataset.lubricants}'
                         data-selected-category=""
                         data-selected-item=""
                         data-placeholder="${firstSelect.dataset.placeholder}"
                         data-row-index="${rowIndex}"
                         data-material-index="${materialIndex}"></div>
                    <div class="input-group-append d-flex">
                        <button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="${rowIndex}">+</button>
                        <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="${rowIndex}" data-material-index="${materialIndex}">×</button>
                    </div>
                </div>
                <input type="hidden" class="material-stock" value="0" />`;

            materialRows.appendChild(materialRow);
            initSelect(materialRow.querySelector('.material-select'));

            const quantityRow = document.createElement('div');
            quantityRow.className = 'quantity-row mb-1';
            quantityRow.innerHTML = `<input type="number" name="models[${rowIndex}].Quantities_List[${materialIndex}]" class="form-control form-control-sm material-quantity-input" placeholder="Qty" min="0" step="0.01" required />`;
            quantityRows.appendChild(quantityRow);
        }

        function removeRow(rowIndex, materialIndex) {
            const materialRows = document.querySelector(`.material-rows[data-row-index="${rowIndex}"]`);
            const quantityRows = document.querySelector(`.quantity-rows[data-row-index="${rowIndex}"]`);
            const rows = Array.from(materialRows.querySelectorAll('.material-row'));
            const quantityRowItems = Array.from(quantityRows.querySelectorAll('.quantity-row'));

            if (rows.length > 1) {
                const target = rows.find(x => x.querySelector('.material-select')?.dataset.materialIndex === materialIndex);
                const position = rows.indexOf(target);

                target?.remove();
                quantityRowItems[position]?.remove();
                reindexRows(rowIndex);
                return;
            }

            rows[0].querySelector('.material-id-input').value = '';
            rows[0].querySelector('.material-category-input').value = '';
            rows[0].querySelector('.material-stock').value = '0';
            quantityRowItems[0].querySelector('input').value = '';

            const select = rows[0].querySelector('.material-select');
            select.dataset.selectedCategory = '';
            select.dataset.selectedItem = '';
            select.querySelector('.display-text').textContent = select.dataset.placeholder;
        }

        function reindexRows(rowIndex) {
            const materialRows = document.querySelector(`.material-rows[data-row-index="${rowIndex}"]`);
            const quantityRows = document.querySelector(`.quantity-rows[data-row-index="${rowIndex}"]`);

            materialRows.querySelectorAll('.material-row').forEach((row, index) => {
                row.querySelector('[name*="MaterialRowIds_List"]').name = `models[${rowIndex}].MaterialRowIds_List[${index}]`;
                row.querySelector('.material-id-input').name = `models[${rowIndex}].MaterialIds_List[${index}]`;
                row.querySelector('.material-category-input').name = `models[${rowIndex}].MaterialCategories_List[${index}]`;
                row.querySelector('.material-select').dataset.materialIndex = index;
                row.querySelector('.remove-material').dataset.materialIndex = index;
            });

            quantityRows.querySelectorAll('.quantity-row input').forEach((input, index) => {
                input.name = `models[${rowIndex}].Quantities_List[${index}]`;
            });
        }

        function initSelect(container) {
            try {
                const spareParts = JSON.parse(container.dataset.spareparts || '[]');
                const lubricants = JSON.parse(container.dataset.lubricants || '[]');
                const placeholder = container.dataset.placeholder || 'Select Material';

                container.innerHTML = `<span class="display-text">${placeholder}</span><span style="color:#6c757d;font-size:.7em;margin-left:5px">▼</span>`;

                const dropdown = document.createElement('div');
                dropdown.className = 'cascading-dropdown';
                document.body.appendChild(dropdown);
                dropdown.onclick = e => e.stopPropagation();

                function displaySelected() {
                    const category = container.dataset.selectedCategory;
                    const id = parseInt(container.dataset.selectedItem);
                    const items = category === 'Lubricants' ? lubricants : spareParts;
                    const item = items.find(x => x.Id === id);
                    const row = container.closest('.material-row');

                    container.querySelector('.display-text').textContent = item
                        ? `${item.Name} (${item.Quantity} ${item.Unit})`
                        : placeholder;

                    row.querySelector('.material-id-input').value = id || '';
                    row.querySelector('.material-category-input').value = category || '';
                    row.querySelector('.material-stock').value = item ? item.Quantity || 0 : 0;
                }

                function showCategories() {
                    dropdown.innerHTML = '';

                    [
                        { name: 'SpareParts', items: spareParts, label: 'Spare Parts' },
                        { name: 'Lubricants', items: lubricants, label: 'Lubricants' }
                    ].forEach(category => {
                        const item = document.createElement('div');
                        item.className = 'dropdown-item type-item';
                        item.innerHTML = `<span>${category.label}</span><small style="color:#6c757d">(${category.items.length})</small>`;
                        item.onclick = e => {
                            e.stopPropagation();
                            showItems(category.name, category.items);
                        };
                        dropdown.appendChild(item);
                    });
                }

                function showItems(category, items) {
                    dropdown.innerHTML = '';

                    const back = document.createElement('div');
                    back.className = 'dropdown-item back-item';
                    back.textContent = 'Back';
                    back.onclick = e => {
                        e.stopPropagation();
                        showCategories();
                    };
                    dropdown.appendChild(back);

                    items.forEach(material => {
                        const item = document.createElement('div');
                        item.className = 'dropdown-item item-detail';
                        item.innerHTML = `${material.Name} <small style="color:#6c757d">(${material.Quantity} ${material.Unit})</small>`;
                        item.onclick = e => {
                            e.stopPropagation();
                            container.dataset.selectedCategory = category;
                            container.dataset.selectedItem = material.Id;
                            displaySelected();
                            dropdown.classList.remove('show');
                        };
                        dropdown.appendChild(item);
                    });
                }

                function positionDropdown() {
                    const rect = container.getBoundingClientRect();
                    dropdown.style.left = rect.left + 'px';
                    dropdown.style.top = rect.bottom + 'px';
                    dropdown.style.width = rect.width + 'px';
                }

                container.onclick = e => {
                    e.stopPropagation();

                    const isOpen = dropdown.classList.contains('show');
                    document.querySelectorAll('.cascading-dropdown').forEach(x => x.classList.remove('show'));

                    if (!isOpen) {
                        showCategories();
                        positionDropdown();
                        dropdown.classList.add('show');
                    }
                };

                document.addEventListener('click', () => dropdown.classList.remove('show'));
                displaySelected();
            } catch {
                container.innerHTML = '<span class="text-danger">Error loading data</span>';
            }
        }
    });
</script>
