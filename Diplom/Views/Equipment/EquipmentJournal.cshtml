@model List<Diplom.Models.EquipmentJournalModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var equipments = ViewBag.Equipments as List<Diplom.Models.EquipmentModel> ?? new();
    var spareParts = ViewBag.SpareParts as List<Diplom.Models.Warehouses.MaterialLogModel> ?? new();
    var lubricants = ViewBag.Lubricants as List<Diplom.Models.Warehouses.MaterialLogModel> ?? new();
    int newIndex = Model?.Count ?? 0;
    double Stock(int? id, string? category) => !id.HasValue ? 0 : ((category == "Lubricants" ? lubricants : spareParts).FirstOrDefault(x => x.Id == id.Value)?.Quantity ?? 0);
}

<style>.select-required-missing{border-color:#dc3545!important;background-color:#f8d7da!important}</style>

<div class="journal-page equipment-journal-page">
    <h3 class="text-center">@Localizer["Equipment Journal"]</h3>
    <div id="equipment-stock-warning" class="alert alert-danger text-center" style="display:none;">@Localizer["Not enough material in warehouse."]</div>
    <form action="/EquipmentJournal/Save" method="post">
        @Html.AntiForgeryToken()
        <div class="journal-table-wrap equipment-journal-table-wrap">
            <table class="table table-bordered table-sm text-center align-middle journal-table equipment-journal-table">
                <thead><tr><th>#</th><th>@Localizer["Equipment"]</th><th>@Localizer["Work Type"]</th><th>@Localizer["Date"]</th><th>@Localizer["Materials"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Working Hours"]</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < (Model?.Count ?? 0); i++)
                    {
                        <tr>
                            <td>@(i + 1)</td><input type="hidden" name="models[@i].Id" value="@Model![i].Id" />
                            <td><select name="models[@i].EquipmentId" class="form-control" required><option value="">-- @Localizer["Select equipment"] --</option>@foreach (var eq in equipments){if (eq.Id == Model[i].EquipmentId){<option value="@eq.Id" selected>@eq.Name</option>}else{<option value="@eq.Id">@eq.Name</option>}}</select></td>
                            <td><input name="models[@i].WorkType" value="@Model[i].WorkType" class="form-control" required /></td>
                            <td><input type="date" name="models[@i].Date" value="@Model[i].Date?.ToString("yyyy-MM-dd")" class="form-control" required /></td>
                            <td class="material-cell"><div class="material-rows" data-row-index="@i">
                                @if (Model[i].JournalMaterials != null && Model[i].JournalMaterials.Any())
                                {
                                    @for (int m = 0; m < Model[i].JournalMaterials.Count; m++)
                                    {
                                        var mat = Model[i].JournalMaterials[m];
                                        <div class="material-row mb-1"><div class="input-group input-group-sm">
                                            <input type="hidden" name="models[@i].MaterialRowIds_List[@m]" value="@mat.Id" />
                                            <input type="hidden" name="models[@i].MaterialIds_List[@m]" value="@mat.MaterialId" class="material-id-input" />
                                            <input type="hidden" name="models[@i].MaterialCategories_List[@m]" value="@mat.MaterialCategory" class="material-category-input" />
                                            <div class="cascading-select form-control form-control-sm material-select" data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)' data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)' data-selected-category="@mat.MaterialCategory" data-selected-item="@mat.MaterialId" data-placeholder="@Localizer["Select Material"]" data-row-index="@i" data-material-index="@m"></div>
                                            <div class="input-group-append d-flex"><button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@i">+</button><button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="@m">×</button></div>
                                        </div><input type="hidden" class="material-stock" value="@(Stock(mat.MaterialId, mat.MaterialCategory) + (mat.Quantity ?? 0))" /></div>
                                    }
                                }
                                else
                                {
                                    <div class="material-row mb-1"><div class="input-group input-group-sm">
                                        <input type="hidden" name="models[@i].MaterialRowIds_List[0]" value="0" /><input type="hidden" name="models[@i].MaterialIds_List[0]" class="material-id-input" /><input type="hidden" name="models[@i].MaterialCategories_List[0]" class="material-category-input" />
                                        <div class="cascading-select form-control form-control-sm material-select" data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)' data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)' data-selected-category="" data-selected-item="" data-placeholder="@Localizer["Select Material"]" data-row-index="@i" data-material-index="0"></div>
                                        <div class="input-group-append d-flex"><button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@i">+</button><button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="0">×</button></div>
                                    </div><input type="hidden" class="material-stock" value="0" /></div>
                                }
                            </div></td>
                            <td class="quantity-cell"><div class="quantity-rows" data-row-index="@i">
                                @if (Model[i].JournalMaterials != null && Model[i].JournalMaterials.Any()) { @for (int m = 0; m < Model[i].JournalMaterials.Count; m++) { <div class="quantity-row mb-1"><input type="number" name="models[@i].Quantities_List[@m]" value="@Model[i].JournalMaterials[m].Quantity" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required /></div> } }
                                else { <div class="quantity-row mb-1"><input type="number" name="models[@i].Quantities_List[0]" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required /></div> }
                            </div></td>
                            <td><input name="models[@i].WorkingHours" value="@Model[i].WorkingHours" class="form-control" required /></td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><td>+</td><input type="hidden" name="models[@newIndex].Id" value="0" />
                    <td><select name="models[@newIndex].EquipmentId" class="form-control" required><option value="" selected>-- @Localizer["Select equipment"] --</option>@foreach (var eq in equipments){<option value="@eq.Id">@eq.Name</option>}</select></td>
                    <td><input name="models[@newIndex].WorkType" class="form-control" required /></td><td><input type="date" name="models[@newIndex].Date" class="form-control" required /></td>
                    <td class="material-cell"><div class="material-rows" data-row-index="@newIndex"><div class="material-row mb-1"><div class="input-group input-group-sm"><input type="hidden" name="models[@newIndex].MaterialRowIds_List[0]" value="0" /><input type="hidden" name="models[@newIndex].MaterialIds_List[0]" class="material-id-input" /><input type="hidden" name="models[@newIndex].MaterialCategories_List[0]" class="material-category-input" /><div class="cascading-select form-control form-control-sm material-select" data-spareparts='@System.Text.Json.JsonSerializer.Serialize(spareParts)' data-lubricants='@System.Text.Json.JsonSerializer.Serialize(lubricants)' data-selected-category="" data-selected-item="" data-placeholder="@Localizer["Select Material"]" data-row-index="@newIndex" data-material-index="0"></div><div class="input-group-append d-flex"><button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="@newIndex">+</button><button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@newIndex" data-material-index="0">×</button></div></div><input type="hidden" class="material-stock" value="0" /></div></div></td>
                    <td class="quantity-cell"><div class="quantity-rows" data-row-index="@newIndex"><div class="quantity-row mb-1"><input type="number" name="models[@newIndex].Quantities_List[0]" class="form-control form-control-sm material-quantity-input" placeholder="@Localizer["Qty"]" min="0" step="0.01" required /></div></div></td><td><input name="models[@newIndex].WorkingHours" class="form-control" required /></td>
                </tr></tfoot>
            </table>
        </div>
        <div class="equipment-journal-actions mt-3"><button type="submit" id="saveButton" class="btn btn-primary">@Localizer["Save"]</button></div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.material-select').forEach(initSelect);document.addEventListener('click',function(e){const add=e.target.closest('.add-material-inline');if(add){e.preventDefault();addRow(add.dataset.rowIndex);return}const rem=e.target.closest('.remove-material');if(rem){e.preventDefault();removeRow(rem.dataset.rowIndex,rem.dataset.materialIndex)}});function addRow(r){const mr=document.querySelector(`.material-rows[data-row-index="${r}"]`),qr=document.querySelector(`.quantity-rows[data-row-index="${r}"]`),first=mr.querySelector('.material-select'),idx=mr.querySelectorAll('.material-row').length;const div=document.createElement('div');div.className='material-row mb-1';div.innerHTML=`<div class="input-group input-group-sm"><input type="hidden" name="models[${r}].MaterialRowIds_List[${idx}]" value="0" /><input type="hidden" name="models[${r}].MaterialIds_List[${idx}]" class="material-id-input" /><input type="hidden" name="models[${r}].MaterialCategories_List[${idx}]" class="material-category-input" /><div class="cascading-select form-control form-control-sm material-select" data-spareparts='${first.dataset.spareparts}' data-lubricants='${first.dataset.lubricants}' data-selected-category="" data-selected-item="" data-placeholder="${first.dataset.placeholder}" data-row-index="${r}" data-material-index="${idx}"></div><div class="input-group-append d-flex"><button type="button" class="btn btn-outline-primary btn-sm add-material-inline" data-row-index="${r}">+</button><button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="${r}" data-material-index="${idx}">×</button></div></div><input type="hidden" class="material-stock" value="0" />`;mr.appendChild(div);const q=document.createElement('div');q.className='quantity-row mb-1';q.innerHTML=`<input type="number" name="models[${r}].Quantities_List[${idx}]" class="form-control form-control-sm material-quantity-input" placeholder="Qty" min="0" step="0.01" required />`;qr.appendChild(q);initSelect(div.querySelector('.material-select'))}function removeRow(r,i){const mr=document.querySelector(`.material-rows[data-row-index="${r}"]`),qr=document.querySelector(`.quantity-rows[data-row-index="${r}"]`),rows=[...mr.querySelectorAll('.material-row')],qrows=[...qr.querySelectorAll('.quantity-row')];if(rows.length>1){const target=rows.find(x=>x.querySelector('.material-select')?.dataset.materialIndex===i),pos=rows.indexOf(target);target?.remove();qrows[pos]?.remove();reindex(r);return}rows[0].querySelector('.material-id-input').value='';rows[0].querySelector('.material-category-input').value='';rows[0].querySelector('.material-stock').value='0';qrows[0].querySelector('input').value='';const s=rows[0].querySelector('.material-select');s.dataset.selectedCategory='';s.dataset.selectedItem='';s.querySelector('.display-text').textContent=s.dataset.placeholder}function reindex(r){const mr=document.querySelector(`.material-rows[data-row-index="${r}"]`),qr=document.querySelector(`.quantity-rows[data-row-index="${r}"]`);mr.querySelectorAll('.material-row').forEach((row,i)=>{row.querySelector('[name*="MaterialRowIds_List"]').name=`models[${r}].MaterialRowIds_List[${i}]`;row.querySelector('.material-id-input').name=`models[${r}].MaterialIds_List[${i}]`;row.querySelector('.material-category-input').name=`models[${r}].MaterialCategories_List[${i}]`;row.querySelector('.material-select').dataset.materialIndex=i;row.querySelector('.remove-material').dataset.materialIndex=i});qr.querySelectorAll('.quantity-row input').forEach((x,i)=>x.name=`models[${r}].Quantities_List[${i}]`)}function initSelect(c){try{const sp=JSON.parse(c.dataset.spareparts||'[]'),lu=JSON.parse(c.dataset.lubricants||'[]'),ph=c.dataset.placeholder||'Select Material';c.innerHTML=`<span class="display-text">${ph}</span><span style="color:#6c757d;font-size:.7em;margin-left:5px">▼</span>`;const d=document.createElement('div');d.className='cascading-dropdown';document.body.appendChild(d);d.onclick=e=>e.stopPropagation();function display(){const cat=c.dataset.selectedCategory,id=parseInt(c.dataset.selectedItem),arr=cat==='Lubricants'?lu:sp,item=arr.find(x=>x.Id===id);c.querySelector('.display-text').textContent=item?`${item.Name} (${item.Quantity} ${item.Unit})`:ph;const row=c.closest('.material-row');row.querySelector('.material-id-input').value=id||'';row.querySelector('.material-category-input').value=cat||'';row.querySelector('.material-stock').value=item?item.Quantity||0:0}function cats(){d.innerHTML='';[{n:'SpareParts',a:sp,l:'Spare Parts'},{n:'Lubricants',a:lu,l:'Lubricants'}].forEach(x=>{const el=document.createElement('div');el.className='dropdown-item type-item';el.innerHTML=`<span>${x.l}</span><small style="color:#6c757d">(${x.a.length})</small>`;el.onclick=e=>{e.stopPropagation();items(x.n,x.a)};d.appendChild(el)})}function items(cat,arr){d.innerHTML='';const b=document.createElement('div');b.className='dropdown-item back-item';b.textContent='Back';b.onclick=e=>{e.stopPropagation();cats()};d.appendChild(b);arr.forEach(it=>{const el=document.createElement('div');el.className='dropdown-item item-detail';el.innerHTML=`${it.Name} <small style="color:#6c757d">(${it.Quantity} ${it.Unit})</small>`;el.onclick=e=>{e.stopPropagation();c.dataset.selectedCategory=cat;c.dataset.selectedItem=it.Id;display();d.classList.remove('show')};d.appendChild(el)})}function pos(){const r=c.getBoundingClientRect();d.style.left=r.left+'px';d.style.top=r.bottom+'px';d.style.width=r.width+'px'}c.onclick=e=>{e.stopPropagation();const open=d.classList.contains('show');document.querySelectorAll('.cascading-dropdown').forEach(x=>x.classList.remove('show'));if(!open){cats();pos();d.classList.add('show')}};document.addEventListener('click',()=>d.classList.remove('show'));display()}catch{c.innerHTML='<span class="text-danger">Error loading data</span>'}}});
</script>
