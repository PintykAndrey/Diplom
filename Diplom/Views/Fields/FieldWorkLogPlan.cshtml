                                                <input type="hidden" name="factModels[@i].MaterialRowIds_List[@idx]" value="@(seedMat?.Id ?? 0)" />
                                                <input type="hidden" name="factModels[@i].MaterialCategories_List[@idx]" value="Seeds" class="material-category" />
                                                <input type="hidden" name="factModels[@i].SeedTypeIds_List[@idx]" value="@(seedMat?.SeedTypeId?.ToString() ?? "")" class="seedtype-id" />
                                                <input type="hidden" name="factModels[@i].MaterialIds_List[@idx]" value="@(seedMat?.MaterialId?.ToString() ?? "")" class="material-id" />
                                                <div class="cascading-select form-control form-control-sm worklog-material-select"
                                                     data-row-index="@i" data-material-index="@idx"
                                                     data-category="Seeds"
                                                     data-seedtype="@(seedMat?.SeedTypeId?.ToString() ?? "")"
                                                     data-materialid="@(seedMat?.MaterialId?.ToString() ?? "")"
                                                     data-placeholder="@Localizer["Select Seeds"]"></div>
                                                <div class="input-group-append d-flex material-btn-spacer"></div>
                                            </div>
                                        </div>
                                        @{ idx++; }

                                        @for (int pm = 0; pm < pestMats.Count; pm++)
                                        {
                                            var m = pestMats[pm];
