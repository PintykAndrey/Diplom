                                    <input type="hidden" name="factModels[@i].PlanFrom" id="factPlanFrom_@i" value="@(row.PlanFrom?.ToString("yyyy-MM-dd") ?? "")" />
                                    <input type="hidden" name="factModels[@i].PlanTo" id="factPlanTo_@i" value="@(row.PlanTo?.ToString("yyyy-MM-dd") ?? "")" />
                                </td>

                                <td>
                                    <select name="factModels[@i].FieldId" class="form-control form-control-sm field-select" data-row-index="@i" required>
                                        <option value="">-- @Localizer["Select field"] --</option>
                                        @foreach (var f in fields)
                                        {
                                            <option value="@f.Id"
                                                    data-area="@f.AreaHectares.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    selected="@(f.Id == row.FieldId)">
                                                @f.Name
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input type="number" step="0.01" name="factModels[@i].AreaHectares" value="@row.AreaHectares"
                                           class="form-control form-control-sm area-input" data-row-index="@i" />
                                </td>

                                <td>
                                    @{
                                        var seedMat = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Seeds").OrderByDescending(x => x.LastModified).FirstOrDefault();
                                        var pestMats = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Pesticides").OrderByDescending(x => x.LastModified).ToList() ?? new List<Diplom.Models.Fields.FieldWorkLogMaterialModel>();
                                        var fertMats = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Fertilizers").OrderByDescending(x => x.LastModified).ToList() ?? new List<Diplom.Models.Fields.FieldWorkLogMaterialModel>();
                                        if (pestMats.Count == 0) pestMats.Add(new Diplom.Models.Fields.FieldWorkLogMaterialModel { Category = "Pesticides" });
                                        if (fertMats.Count == 0) fertMats.Add(new Diplom.Models.Fields.FieldWorkLogMaterialModel { Category = "Fertilizers" });

                                        var idx = 0;
                                    }

                                    <div class="material-rows" data-row-index="@i">
                                        <div class="material-row mb-1" data-material-index="@idx" data-category="Seeds">
