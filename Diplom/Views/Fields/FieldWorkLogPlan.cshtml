                                        @foreach (var op in operations)
                                        {
                                            <option value="@op.Id" selected="@(op.Id == row.OperationId)">@op.Name</option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input type="text" class="form-control form-control-sm date-range" placeholder="@Localizer["Select date range"]"
                                           data-row-index="@i"
