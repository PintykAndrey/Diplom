                                                    <input type="hidden" name="factModels[@i].AggregateRowIds_List[0]" value="0" />
                                                    <input type="hidden" name="factModels[@i].AggregateEquipmentTypes_List[0]" value="" class="aggregate-type-input" />
                                                    <input type="hidden" name="factModels[@i].AggregateEquipmentIds_List[0]" value="" class="aggregate-equipment-id-input" />

                                                    <div class="cascading-select form-control form-control-sm worklog-aggregate-select"
                                                         data-row-index="@i" data-aggregate-index="0"
                                                         data-equipmenttype="" data-equipmentid=""
                                                         data-placeholder="@Localizer["Select equipment"]"></div>

                                                    <div class="input-group-append d-flex">
                                                        <button type="button" class="btn btn-outline-primary btn-sm add-aggregate" data-row-index="@i">+</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm remove-aggregate" data-row-index="@i" data-aggregate-index="0">&times;</button>
