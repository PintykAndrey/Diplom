    function addAggregateRow(rowIndex) {
        const scope = document.querySelector('.tab-content.active') || document;
        const prefix = scope.id === 'fact-content' ? 'factModels' : 'models';
        const rows = scope.querySelector(`.aggregate-rows[data-row-index="${rowIndex}"]`);
