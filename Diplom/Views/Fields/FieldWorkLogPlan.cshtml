            <thead class="table-light">
                <tr>
                    <th>&#8470;</th>
                    <th>@Localizer["Operation"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Field"]</th>
                    <th>@Localizer["Area"] @Localizer["ha"])</th>
                    <th>@Localizer["Materials"]</th>
                    <th>@Localizer["Rate (kg/ha)"]</th>
                    <th>@Localizer["Total"]</th>
                    <th>@Localizer["Fuel Rate"]</th>
                    <th>@Localizer["Fuel Total"]</th>
                    <th>@Localizer["Aggregate"]</th>
                    <th>@Localizer["Mechanic"]</th>
                    <th>@Localizer["Last Modified"]</th>
                </tr>
            </thead>

            <tbody>
                @if (factRows.Any())
                {
                        for (int i = 0; i < factRows.Count; i++)
