            </tbody>

            <tfoot>
                <tr class="new-entry-row">
                    <td>+</td>
                    <input type="hidden" name="factModels[@factNewIndex].Id" value="0" />

                    <td>
                        <select name="factModels[@factNewIndex].OperationId" class="form-control form-control-sm">
