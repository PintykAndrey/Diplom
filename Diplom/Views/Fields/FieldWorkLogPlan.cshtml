    <div id="fact-content" class="tab-content">
        <form action="@Url.Action("SaveFieldWorkLog", "Fields")" method="post">
        @Html.AntiForgeryToken()
        @{
            var factRows = (ViewBag.FieldWorkLogs as List<Diplom.Models.Fields.FieldWorkLogModel>) ?? new List<Diplom.Models.Fields.FieldWorkLogModel>();
            var factNewIndex = factRows.Count;
        }

        <div class="material-rows-data-container d-none"
             data-seedtypes='@System.Text.Json.JsonSerializer.Serialize(seedTypes ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-pesticidetypes='@System.Text.Json.JsonSerializer.Serialize((ViewBag.PesticideTypes as List<Diplom.Models.Tools.EncyclopediaItem>) ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-fertilizertypes='@System.Text.Json.JsonSerializer.Serialize((ViewBag.FertilizerTypes as List<Diplom.Models.Tools.EncyclopediaItem>) ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-seeds='@System.Text.Json.JsonSerializer.Serialize(seeds ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-pesticides='@System.Text.Json.JsonSerializer.Serialize(pesticides ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-fertilizers='@System.Text.Json.JsonSerializer.Serialize(fertilizers ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-fuel='@System.Text.Json.JsonSerializer.Serialize((ViewBag.Fuel as List<Diplom.Models.Warehouses.MaterialLogModel>) ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'>
