        newRow.className = 'aggregate-row mb-1';
        newRow.dataset.aggregateIndex = newIndex;
        newRow.innerHTML = `
            <div class="input-group input-group-sm">
                <input type="hidden" name="${prefix}[${rowIndex}].AggregateRowIds_List[${newIndex}]" value="0" />

                <input type="hidden" name="${prefix}[${rowIndex}].AggregateEquipmentTypes_List[${newIndex}]" value="" class="aggregate-type-input" />
                <input type="hidden" name="${prefix}[${rowIndex}].AggregateEquipmentIds_List[${newIndex}]" value="" class="aggregate-equipment-id-input" />

                <div class="cascading-select form-control form-control-sm worklog-aggregate-select"
                     data-row-index="${rowIndex}"
                     data-aggregate-index="${newIndex}"
                     data-equipmenttype=""
                     data-equipmentid=""
                     data-placeholder="Select equipment"></div>

                <div class="input-group-append d-flex">
                    <button type="button" class="btn btn-outline-primary btn-sm add-aggregate" data-row-index="${rowIndex}">+</button>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-aggregate" data-row-index="${rowIndex}" data-aggregate-index="${newIndex}">&times;</button>
                </div>
            </div>
        `;

        rows.appendChild(newRow);

        initWorklogAggregateSelect(newRow.querySelector('.worklog-aggregate-select'));
    }

    function removeAggregateRow(rowIndex, aggregateIndex) {
        const scope = document.querySelector('.tab-content.active') || document;
        const rows = scope.querySelector(`.aggregate-rows[data-row-index="${rowIndex}"]`);
        if (!rows) return;
        const els = rows.querySelectorAll('.aggregate-row');
        if (els.length <= 1) return;

        els[aggregateIndex]?.remove();
        reindexAggregateRows(rowIndex);
    }

    function reindexAggregateRows(rowIndex) {
        const scope = document.querySelector('.tab-content.active') || document;
        const prefix = scope.id === 'fact-content' ? 'factModels' : 'models';
        const rows = scope.querySelector(`.aggregate-rows[data-row-index="${rowIndex}"]`);
        if (!rows) return;
        rows.querySelectorAll('.aggregate-row').forEach((row, index) => {
            row.dataset.aggregateIndex = index;

            const rowId = row.querySelector('input[name*="AggregateRowIds_List"]');
            const typeInput = row.querySelector('.aggregate-type-input');
            const eqInput = row.querySelector('.aggregate-equipment-id-input');
            const select = row.querySelector('.worklog-aggregate-select');
            const removeBtn = row.querySelector('.remove-aggregate');

            if (rowId) rowId.name = `${prefix}[${rowIndex}].AggregateRowIds_List[${index}]`;
            if (typeInput) typeInput.name = `${prefix}[${rowIndex}].AggregateEquipmentTypes_List[${index}]`;
            if (eqInput) eqInput.name = `${prefix}[${rowIndex}].AggregateEquipmentIds_List[${index}]`;
            if (select) select.dataset.aggregateIndex = index;
            if (removeBtn) {
                removeBtn.dataset.aggregateIndex = index;
            }
        });
    }
</script>
