                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm date-range" placeholder="@Localizer["Select date range"]"
                               data-row-index="@factNewIndex" />
                        <input type="hidden" name="factModels[@factNewIndex].PlanFrom" id="factPlanFrom_@factNewIndex" value="" />
                        <input type="hidden" name="factModels[@factNewIndex].PlanTo" id="factPlanTo_@factNewIndex" value="" />
                    </td>
                    <td>
                        <select name="factModels[@factNewIndex].FieldId" class="form-control form-control-sm field-select" data-row-index="@factNewIndex">
                            <option value="">-- @Localizer["Select field"] --</option>
                            @foreach (var f in fields)
                            {
                                <option value="@f.Id" data-area="@f.AreaHectares">@f.Name (@f.AreaHectares @Localizer["ha"])</option>
