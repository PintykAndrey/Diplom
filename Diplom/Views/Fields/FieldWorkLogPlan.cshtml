@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent renderMaterialCategoryRows(int rowIndex, List<Diplom.Models.Fields.FieldWorkLogPlanMaterialModel> items, string category) {
        var content = new System.Text.StringBuilder();
        int count = items?.Count ?? 1;
        if (count == 0) count = 1;
        for (int m = 0; m < count; m++) {
            var item = (items != null && m < items.Count) ? items[m] : null;
            content.Append($@"
                <div class=""material-row mb-1"" data-category=""{category}"" data-material-index=""{m}"">
                    <div class=""input-group input-group-sm"">
                        <input type=""hidden"" name=""models[{rowIndex}].MaterialRowIds_List[{m}]"" value=""{(item?.Id ?? 0)}"" />
                        <input type=""hidden"" name=""models[{rowIndex}].MaterialCategories_List[{m}]"" value=""{category}"" class=""material-category"" />
                        <input type=""hidden"" name=""models[{rowIndex}].SeedTypeIds_List[{m}]"" value=""{(item?.SeedTypeId?.ToString() ?? "")}"" class=""seedtype-id"" />
                        <input type=""hidden"" name=""models[{rowIndex}].MaterialIds_List[{m}]"" value=""{(item?.MaterialId?.ToString() ?? "")}"" class=""material-id"" />
                        <div class=""cascading-select form-control form-control-sm worklog-material-select""
                             data-row-index=""{rowIndex}"" data-material-index=""{m}"" data-category=""{category}""
                             data-seedtype=""{(item?.SeedTypeId?.ToString() ?? "")}"" data-materialid=""{(item?.MaterialId?.ToString() ?? "")}""
                             data-placeholder=""Select {category}""></div>
                        <div class=""input-group-append d-flex"">
                            <button type=""button"" class=""btn btn-outline-primary btn-sm add-material-btn"" data-row-index=""{rowIndex}"" data-category=""{category}"">+</button>
                            <button type=""button"" class=""btn btn-outline-danger btn-sm remove-material-btn"" data-row-index=""{rowIndex}"" data-category=""{category}"" data-material-index=""{m}"">&times;</button>
                        </div>
                    </div>
                </div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(content.ToString());
    }

    public Microsoft.AspNetCore.Html.IHtmlContent renderRateCategoryRows(int rowIndex, List<Diplom.Models.Fields.FieldWorkLogPlanMaterialModel> items, string category) {
        var content = new System.Text.StringBuilder();
        int count = items?.Count ?? 1;
        if (count == 0) count = 1;
        for (int m = 0; m < count; m++) {
            var item = (items != null && m < items.Count) ? items[m] : null;
            content.Append($@"
                <div class=""rate-row mb-1"" data-category=""{category}"" data-material-index=""{m}"">
                    <input type=""number"" step=""0.01"" name=""models[{rowIndex}].Rates_List[{m}]"" value=""{(item?.Rate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")}""
                           class=""form-control form-control-sm rate-input"" data-row-index=""{rowIndex}"" data-category=""{category}"" data-material-index=""{m}"" />
                </div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(content.ToString());
    }

    public Microsoft.AspNetCore.Html.IHtmlContent renderTotalCategoryRows(int rowIndex, List<Diplom.Models.Fields.FieldWorkLogPlanMaterialModel> items, string category) {
        var content = new System.Text.StringBuilder();
        int count = items?.Count ?? 1;
        if (count == 0) count = 1;
        for (int m = 0; m < count; m++) {
            var item = (items != null && m < items.Count) ? items[m] : null;
            content.Append($@"
                <div class=""total-row mb-1"" data-category=""{category}"" data-material-index=""{m}"">
                    <input type=""number"" step=""0.01"" name=""models[{rowIndex}].Totals_List[{m}]"" value=""{(item?.Total?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")}""
                           class=""form-control form-control-sm total-input"" data-row-index=""{rowIndex}"" data-category=""{category}"" data-material-index=""{m}"" />
                </div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(content.ToString());
    }
}

@model List<Diplom.Models.Fields.FieldWorkLogPlanModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Field Work LogPlan"].Value;
    int newIndex = Model?.Count ?? 0;

    var fields = ViewBag.Fields as IEnumerable<Diplom.Models.Fields.FieldEntity> ?? Enumerable.Empty<Diplom.Models.Fields.FieldEntity>();
    var operations = ViewBag.Operations as IEnumerable<Diplom.Models.Tools.EncyclopediaItem> ?? Enumerable.Empty<Diplom.Models.Tools.EncyclopediaItem>();
    var seedTypes = ViewBag.SeedTypes as IEnumerable<Diplom.Models.Tools.EncyclopediaItem> ?? Enumerable.Empty<Diplom.Models.Tools.EncyclopediaItem>();

    var seeds = ViewBag.Seeds as IEnumerable<Diplom.Models.Warehouses.MaterialLogModel> ?? Enumerable.Empty<Diplom.Models.Warehouses.MaterialLogModel>();
    var pesticides = ViewBag.Pesticides as IEnumerable<Diplom.Models.Warehouses.MaterialLogModel> ?? Enumerable.Empty<Diplom.Models.Warehouses.MaterialLogModel>();
    var fertilizers = ViewBag.Fertilizers as IEnumerable<Diplom.Models.Warehouses.MaterialLogModel> ?? Enumerable.Empty<Diplom.Models.Warehouses.MaterialLogModel>();

    var operators = ViewBag.Operators as IEnumerable<Diplom.Models.OperatorModel> ?? Enumerable.Empty<Diplom.Models.OperatorModel>();
    var equipments = ViewBag.Equipments as IEnumerable<Diplom.Models.EquipmentModel> ?? Enumerable.Empty<Diplom.Models.EquipmentModel>();
}

<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />

<style>
    .select-required-missing {
        border-color: #fd7e14 !important;
        background-color: #fff3cd !important;
        box-shadow: 0 0 0 0.15rem rgba(253, 126, 20, 0.25) !important;
    }


    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .nav-tabs .nav-link {
        cursor: pointer;
    }

    .nav-tabs .nav-link.active {
        font-weight: 600;
    }

    .toggle-switch {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .toggle-switch label {
        font-weight: 500;
        cursor: pointer;
    }

    .toggle-switch input[type="checkbox"] {
        width: 50px;
        height: 26px;
        appearance: none;
        background: #ccc;
        border-radius: 13px;
        position: relative;
        cursor: pointer;
        transition: background 0.3s;
    }

    .toggle-switch input[type="checkbox"]:checked {
        background: #0d6efd;
    }

    .toggle-switch input[type="checkbox"]::before {
        content: '';
        position: absolute;
        width: 22px;
        height: 22px;
        background: white;
        border-radius: 50%;
        top: 2px;
        left: 2px;
        transition: transform 0.3s;
    }

    .toggle-switch input[type="checkbox"]:checked::before {
        transform: translateX(24px);
    }

    .fact-stock-warning {
        display: none;
    }
</style>

<div class="container-fluid mt-4">
    <h2 class="mb-3 text-center">@Localizer["Field Work Log"]</h2>

    <div class="toggle-switch justify-content-center" data-allow-view-mode-action="true">
        <label>@Localizer["Plan"]</label>
        <input type="checkbox" id="plan-fact-toggle" onchange="switchTab(this.checked ? 'fact' : 'plan')" />
        <label>@Localizer["Fact"]</label>
    </div>

    @if (TempData["FactStockError"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["FactStockError"]
        </div>
    }

    <div id="fact-stock-warning" class="alert alert-danger text-center fact-stock-warning">
        @Localizer["Not enough materials or fuel in warehouse."]
    </div>

    @if (ViewBag.SelectedTab == "fact")
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const toggle = document.getElementById('plan-fact-toggle');
                if (toggle) {
                    toggle.checked = true;
                    switchTab('fact');
                }
            });
        </script>
    }

    <div id="plan-content" class="tab-content active">
        <form action="@Url.Action("SaveFieldWorkLogPlan", "Fields")" method="post">
        @Html.AntiForgeryToken()

        <div class="material-rows-data-container d-none"
             data-seedtypes='@System.Text.Json.JsonSerializer.Serialize(seedTypes ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-pesticidetypes='@System.Text.Json.JsonSerializer.Serialize((ViewBag.PesticideTypes as List<Diplom.Models.Tools.EncyclopediaItem>) ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-fertilizertypes='@System.Text.Json.JsonSerializer.Serialize((ViewBag.FertilizerTypes as List<Diplom.Models.Tools.EncyclopediaItem>) ?? new List<Diplom.Models.Tools.EncyclopediaItem>())'
             data-seeds='@System.Text.Json.JsonSerializer.Serialize(seeds ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-pesticides='@System.Text.Json.JsonSerializer.Serialize(pesticides ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-fertilizers='@System.Text.Json.JsonSerializer.Serialize(fertilizers ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'
             data-fuel='@System.Text.Json.JsonSerializer.Serialize((ViewBag.Fuel as List<Diplom.Models.Warehouses.MaterialLogModel>) ?? new List<Diplom.Models.Warehouses.MaterialLogModel>())'>
        </div>

        <table class="table table-bordered table-sm text-center align-middle field-worklog-table">
            <thead class="table-light">
                <tr>
                    <th>&#8470;</th>
                    <th>@Localizer["Operation"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Field"]</th>
                    <th>@Localizer["Area"] (@Localizer["ha"])</th>
                    <th>@Localizer["Materials"]</th>
                    <th>@Localizer["Rate (kg/ha)"]</th>
                    <th>@Localizer["Total"]</th>
                    <th>@Localizer["Fuel Rate"]</th>
                    <th>@Localizer["Fuel Total"]</th>
                    <th>@Localizer["Aggregate"]</th>
                    <th>@Localizer["Mechanic"]</th>
                    <th>@Localizer["Last Modified"]</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        var row = Model[i];
                        var materialCount = row.Materials?.Count ?? 0;
                        var aggregateCount = row.Aggregates?.Count ?? 0;

                        <tr>
                            <td>@(i + 1)</td>
                            <input type="hidden" name="models[@i].Id" value="@row.Id" />

                            <td>
                                <select name="models[@i].OperationId" class="form-control form-control-sm" required>
                                    <option value="">-- @Localizer["Select operation"] --</option>
                                    @foreach (var op in operations)
                                    {
                                        <option value="@op.Id" selected="@(op.Id == row.OperationId)">@op.Name</option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="text" class="form-control form-control-sm date-range" placeholder="@Localizer["Select date range"]"
                                       data-row-index="@i"
                                       value="@(row.PlanFrom != null && row.PlanTo != null ? row.PlanFrom.Value.ToString("yyyy-MM-dd") + " to " + row.PlanTo.Value.ToString("yyyy-MM-dd") : "")" />
                                <input type="hidden" name="models[@i].PlanFrom" id="planFrom_@i" value="@(row.PlanFrom?.ToString("yyyy-MM-dd") ?? "")" />
                                <input type="hidden" name="models[@i].PlanTo" id="planTo_@i" value="@(row.PlanTo?.ToString("yyyy-MM-dd") ?? "")" />
                            </td>

                            <td>
                                <select name="models[@i].FieldId" class="form-control form-control-sm field-select" data-row-index="@i" required>
                                    <option value="">-- @Localizer["Select field"] --</option>
                                    @foreach (var f in fields)
                                    {
                                        <option value="@f.Id"
                                                data-area="@f.AreaHectares.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                selected="@(f.Id == row.FieldId)">
                                            @f.Name
                                        </option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="number" step="0.01" name="models[@i].AreaHectares" value="@row.AreaHectares"
                                       class="form-control form-control-sm area-input" data-row-index="@i" />
                            </td>

                            <td>
                                @{
                                    var seedMat = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Seeds").OrderByDescending(x => x.LastModified).FirstOrDefault();
                                    var pestMats = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Pesticides").OrderByDescending(x => x.LastModified).ToList() ?? new List<Diplom.Models.Fields.FieldWorkLogPlanMaterialModel>();
                                    var fertMats = row.Materials?.Where(m => m.ArchivedAt == null && m.Category == "Fertilizers").OrderByDescending(x => x.LastModified).ToList() ?? new List<Diplom.Models.Fields.FieldWorkLogPlanMaterialModel>();
                                    if (pestMats.Count == 0) pestMats.Add(new Diplom.Models.Fields.FieldWorkLogPlanMaterialModel { Category = "Pesticides" });
                                    if (fertMats.Count == 0) fertMats.Add(new Diplom.Models.Fields.FieldWorkLogPlanMaterialModel { Category = "Fertilizers" });

                                    var idx = 0;
                                }

                                <div class="material-rows" data-row-index="@i">
                                    <div class="material-row mb-1" data-material-index="@idx" data-category="Seeds">
                                        <div class="input-group input-group-sm">
                                            <input type="hidden" name="models[@i].MaterialRowIds_List[@idx]" value="@(seedMat?.Id ?? 0)" />
                                            <input type="hidden" name="models[@i].MaterialCategories_List[@idx]" value="Seeds" class="material-category" />
                                            <input type="hidden" name="models[@i].SeedTypeIds_List[@idx]" value="@(seedMat?.SeedTypeId?.ToString() ?? "")" class="seedtype-id" />
                                            <input type="hidden" name="models[@i].MaterialIds_List[@idx]" value="@(seedMat?.MaterialId?.ToString() ?? "")" class="material-id" />
                                            <div class="cascading-select form-control form-control-sm worklog-material-select"
                                                 data-row-index="@i" data-material-index="@idx"
                                                 data-category="Seeds"
                                                 data-seedtype="@(seedMat?.SeedTypeId?.ToString() ?? "")"
                                                 data-materialid="@(seedMat?.MaterialId?.ToString() ?? "")"
                                                 data-placeholder="@Localizer["Select Seeds"]"></div>
                                            <div class="input-group-append d-flex material-btn-spacer"></div>
                                        </div>
                                    </div>
                                    @{ idx++; }

                                    @for (int pm = 0; pm < pestMats.Count; pm++)
                                    {
                                        var m = pestMats[pm];
                                        <div class="material-row mb-1" data-material-index="@idx" data-category="Pesticides">
                                            <div class="input-group input-group-sm">
                                                <input type="hidden" name="models[@i].MaterialRowIds_List[@idx]" value="@(m.Id)" />
                                                <input type="hidden" name="models[@i].MaterialCategories_List[@idx]" value="Pesticides" class="material-category" />
                                                <input type="hidden" name="models[@i].SeedTypeIds_List[@idx]" value="@(m.SeedTypeId?.ToString() ?? "")" class="seedtype-id" />
                                                <input type="hidden" name="models[@i].MaterialIds_List[@idx]" value="@(m.MaterialId?.ToString() ?? "")" class="material-id" />
                                                <div class="cascading-select form-control form-control-sm worklog-material-select"
                                                     data-row-index="@i" data-material-index="@idx"
                                                     data-category="Pesticides"
                                                     data-seedtype="@(m.SeedTypeId?.ToString() ?? "")"
                                                     data-materialid="@(m.MaterialId?.ToString() ?? "")"
                                                     data-placeholder="@Localizer["Select Pesticides"]"></div>
                                                <div class="input-group-append d-flex">
                                                    <button type="button" class="btn btn-outline-primary btn-sm add-material" data-row-index="@i" data-category="Pesticides">+</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="@idx">&times;</button>
                                                </div>
                                            </div>
                                        </div>
                                        idx++;
                                    }

                                    @for (int fm = 0; fm < fertMats.Count; fm++)
                                    {
                                        var m = fertMats[fm];
                                        <div class="material-row mb-1" data-material-index="@idx" data-category="Fertilizers">
                                            <div class="input-group input-group-sm">
                                                <input type="hidden" name="models[@i].MaterialRowIds_List[@idx]" value="@(m.Id)" />
                                                <input type="hidden" name="models[@i].MaterialCategories_List[@idx]" value="Fertilizers" class="material-category" />
                                                <input type="hidden" name="models[@i].SeedTypeIds_List[@idx]" value="@(m.SeedTypeId?.ToString() ?? "")" class="seedtype-id" />
                                                <input type="hidden" name="models[@i].MaterialIds_List[@idx]" value="@(m.MaterialId?.ToString() ?? "")" class="material-id" />
                                                <div class="cascading-select form-control form-control-sm worklog-material-select"
                                                     data-row-index="@i" data-material-index="@idx"
                                                     data-category="Fertilizers"
                                                     data-seedtype="@(m.SeedTypeId?.ToString() ?? "")"
                                                     data-materialid="@(m.MaterialId?.ToString() ?? "")"
                                                     data-placeholder="@Localizer["Select Fertilizers"]"></div>
                                                <div class="input-group-append d-flex">
                                                    <button type="button" class="btn btn-outline-primary btn-sm add-material" data-row-index="@i" data-category="Fertilizers">+</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm remove-material" data-row-index="@i" data-material-index="@idx">&times;</button>
                                                </div>
                                            </div>
                                        </div>
                                        idx++;
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="rate-rows" data-row-index="@i">
                                    @{
                                        var idxR = 0;
                                    }
                                    <div class="rate-row mb-1" data-material-index="@idxR">
                                        <input type="number" step="0.01" name="models[@i].Rates_List[@idxR]" value="@(seedMat?.Rate)"
                                               class="form-control form-control-sm rate-input" data-row-index="@i" data-material-index="@idxR" />
                                    </div>
                                    @{ idxR++; }

                                    @for (int pm = 0; pm < pestMats.Count; pm++)
                                    {
                                        var m = pestMats[pm];
                                        <div class="rate-row mb-1" data-material-index="@idxR">
                                            <input type="number" step="0.01" name="models[@i].Rates_List[@idxR]" value="@(m.Rate)"
                                                   class="form-control form-control-sm rate-input" data-row-index="@i" data-material-index="@idxR" />
                                        </div>
                                        idxR++;
                                    }

                                    @for (int fm = 0; fm < fertMats.Count; fm++)
                                    {
                                        var m = fertMats[fm];
                                        <div class="rate-row mb-1" data-material-index="@idxR">
                                            <input type="number" step="0.01" name="models[@i].Rates_List[@idxR]" value="@(m.Rate)"
                                                   class="form-control form-control-sm rate-input" data-row-index="@i" data-material-index="@idxR" />
                                        </div>
                                        idxR++;
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="total-rows" data-row-index="@i">
                                    @{
                                        var idxT = 0;
                                    }
                                    <div class="total-row mb-1" data-material-index="@idxT">
                                        <input type="number" step="0.01" name="models[@i].Totals_List[@idxT]" value="@(seedMat?.Total)"
                                               class="form-control form-control-sm total-input" data-row-index="@i" data-material-index="@idxT" />
                                    </div>
                                    @{ idxT++; }

                                    @for (int pm = 0; pm < pestMats.Count; pm++)
                                    {
                                        var m = pestMats[pm];
                                        <div class="total-row mb-1" data-material-index="@idxT">
                                            <input type="number" step="0.01" name="models[@i].Totals_List[@idxT]" value="@(m.Total)"
                                                   class="form-control form-control-sm total-input" data-row-index="@i" data-material-index="@idxT" />
                                        </div>
                                        idxT++;
                                    }

                                    @for (int fm = 0; fm < fertMats.Count; fm++)
                                    {
                                        var m = fertMats[fm];
                                        <div class="total-row mb-1" data-material-index="@idxT">
                                            <input type="number" step="0.01" name="models[@i].Totals_List[@idxT]" value="@(m.Total)"
                                                   class="form-control form-control-sm total-input" data-row-index="@i" data-material-index="@idxT" />
                                        </div>
                                        idxT++;
                                    }
                                </div>
                            </td>

                            <td>
                                <input type="number" step="0.01" name="models[@i].FuelRate" value="@row.FuelRate" class="form-control form-control-sm fuel-rate" data-row-index="@i" />
                            </td>

                            <td>
                                <input type="number" step="0.01" name="models[@i].FuelTotal" value="@row.FuelTotal" class="form-control form-control-sm fuel-total" data-row-index="@i" />
                            </td>

                            <td>
                                <div class="aggregate-rows" data-row-index="@i"
                                     data-equipments='@System.Text.Json.JsonSerializer.Serialize(equipments ?? new List<Diplom.Models.EquipmentModel>())'>

                                    @if (row.Aggregates != null && row.Aggregates.Any())
                                    {
                                        for (int a = 0; a < row.Aggregates.Count; a++)
                                        {
                                            var ag = row.Aggregates[a];
                                            <div class="aggregate-row mb-1" data-aggregate-index="@a">
                                                <div class="input-group input-group-sm">
                                                    <input type="hidden" name="models[@i].AggregateRowIds_List[@a]" value="@ag.Id" />
                                                    <input type="hidden" name="models[@i].AggregateEquipmentTypes_List[@a]" value="@((int?)ag.EquipmentType)" class="aggregate-type-input" />
                                                    <input type="hidden" name="models[@i].AggregateEquipmentIds_List[@a]" value="@ag.EquipmentId" class="aggregate-equipment-id-input" />

                                                    <div class="cascading-select form-control form-control-sm worklog-aggregate-select"
                                                         data-row-index="@i" data-aggregate-index="@a"
                                                         data-equipmenttype="@((int?)ag.EquipmentType)" data-equipmentid="@ag.EquipmentId"
                                                         data-placeholder="@Localizer["Select equipment"]"></div>

                                                    <div class="input-group-append d-flex">
                                                        <button type="button" class="btn btn-outline-primary btn-sm add-aggregate" data-row-index="@i">+</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm remove-aggregate" data-row-index="@i" data-aggregate-index="@a">&times;</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="aggregate-row mb-1" data-aggregate-index="0">
                                            <div class="input-group input-group-sm">
                                                <input type="hidden" name="models[@i].AggregateRowIds_List[0]" value="0" />
                                                <input type="hidden" name="models[@i].AggregateEquipmentTypes_List[0]" value="" class="aggregate-type-input" />
                                                <input type="hidden" name="models[@i].AggregateEquipmentIds_List[0]" value="" class="aggregate-equipment-id-input" />

                                                <div class="cascading-select form-control form-control-sm worklog-aggregate-select"
                                                     data-row-index="@i" data-aggregate-index="0"
                                                     data-equipmenttype="" data-equipmentid=""
                                                     data-placeholder="@Localizer["Select equipment"]"></div>

                                                <div class="input-group-append d-flex">
                                                    <button type="button" class="btn btn-outline-primary btn-sm add-aggregate" data-row-index="@i">+</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm remove-aggregate" data-row-index="@i" data-aggregate-index="0">&times;</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>

                            <td>
                                <select name="models[@i].MechanicId" class="form-control form-control-sm" required>
                                    <option value="">-- @Localizer["Select"] --</option>
                                    @foreach (var o in operators)
                                    {
                                        var name = $"{o.LastName} {o.FirstName} {o.Surname}".Trim();
                                        <option value="@o.Id" selected="@(o.Id == row.MechanicId)">@name</option>
                                    }
                                </select>
                            </td>

                            <td>
                                @row.LastModified.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>
                        </tr>
                    }
                }
            </tbody>

            <tfoot>
                <tr class="new-entry-row">
                    <td>+</td>
                    <input type="hidden" name="models[@newIndex].Id" value="0" />

                    <td>
                        <select name="models[@newIndex].OperationId" class="form-control form-control-sm">
                            <option value="">-- @Localizer["Select operation"] --</option>
