                                        {
                                            var m = pestMats[pm];
                                            <div class="total-row mb-1" data-material-index="@idxT">
                                                <input type="number" step="0.01" name="factModels[@i].Totals_List[@idxT]" value="@(m.Total)"
                                                       class="form-control form-control-sm total-input" data-row-index="@i" data-material-index="@idxT" />
                                            </div>
                                            idxT++;
                                        }

