@using Diplom.Models
@using Diplom.Models.Identity
@{
    ViewData["Title"] = "Sharing";
    var friends = ViewBag.Friends as List<ApplicationUser> ?? new List<ApplicationUser>();
    var incomingRequests = ViewBag.IncomingRequests as List<FriendRequest> ?? new List<FriendRequest>();
    var incomingUsers = ViewBag.IncomingUsers as Dictionary<string, ApplicationUser> ?? new Dictionary<string,
    ApplicationUser>();
    var outgoingRequests = ViewBag.OutgoingRequests as List<FriendRequest> ?? new List<FriendRequest>();
    var outgoingUsers = ViewBag.OutgoingUsers as Dictionary<string, ApplicationUser> ?? new Dictionary<string,
    ApplicationUser>();
    var grants = ViewBag.Grants as List<DataAccessGrant> ?? new List<DataAccessGrant>();
    var sharedWithMeGrants = ViewBag.SharedWithMeGrants as List<DataAccessGrant> ?? new List<DataAccessGrant>();
    var sections = ViewBag.Sections as SharedDataSection[] ?? Array.Empty<SharedDataSection>();
    var accessLevels = ViewBag.AccessLevels as DataAccessLevel[] ?? Array.Empty<DataAccessLevel>();
}

<div class="container-fluid">
    <h2 class="mb-4">Friends & Access</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add friend</h5>
            <form asp-action="SendRequest" method="post" class="row g-2">
                <div class="col-md-8">
                    <input name="login" class="form-control" placeholder="Email or username tag, e.g. andrey#1234" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" type="submit">Send request</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Incoming requests</h5>
                    @if (!incomingRequests.Any())
                    {
                        <div class="text-muted">No incoming requests.</div>
                    }
                    @foreach (var request in incomingRequests)
                    {
                        var user = incomingUsers.GetValueOrDefault(request.SenderUserId);
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <strong>@(user?.DisplayName ?? user?.Email)</strong>
                                <div class="text-muted small">@user?.UserTag</div>
                            </div>
                            <div class="d-flex gap-2">
                                <form asp-action="AcceptRequest" method="post">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn btn-success btn-sm" type="submit">Accept</button>
                                </form>
                                <form asp-action="RejectRequest" method="post">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Outgoing requests</h5>
                    @if (!outgoingRequests.Any())
                    {
                        <div class="text-muted">No outgoing requests.</div>
                    }
                    @foreach (var request in outgoingRequests)
                    {
                        var user = outgoingUsers.GetValueOrDefault(request.ReceiverUserId);
                        <div class="border-bottom py-2">
                            <strong>@(user?.DisplayName ?? user?.Email)</strong>
                            <div class="text-muted small">@user?.UserTag</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Friends</h5>
            @if (!friends.Any())
            {
                <div class="text-muted">No friends yet.</div>
            }
            @foreach (var friend in friends)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h6 class="mb-1">@friend.DisplayName</h6>
                            <div class="text-muted small">@friend.UserTag</div>
                            <div class="text-muted small">@friend.Email</div>
                        </div>
                        <form asp-action="RemoveFriend" method="post">
                            <input type="hidden" name="friendUserId" value="@friend.Id" />
                            <button class="btn btn-outline-danger btn-sm" type="submit">Remove</button>
                        </form>
                    </div>

                    <form asp-action="SaveAccess" method="post" class="row g-2 mt-3">
                        <input type="hidden" name="friendUserId" value="@friend.Id" />
                        <div class="col-md-5">
                            <select name="section" class="form-select">
                                @foreach (var sharedSection in sections)
                                {
                                    <option value="@sharedSection">@sharedSection</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select name="accessLevel" class="form-select">
                                @foreach (var accessLevel in accessLevels)
                                {
                                    <option value="@accessLevel">@accessLevel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100" type="submit">Grant</button>
                        </div>
                    </form>

                    <div class="mt-3">
                        @foreach (var incomingGrant in sharedWithMeGrants.Where(x => x.OwnerUserId == friend.Id))
                        {
                            <form asp-action="OpenSharedData" method="post" class="d-inline-block me-2 mb-2">
                                <input type="hidden" name="ownerUserId" value="@friend.Id" />
                                <input type="hidden" name="section" value="@incomingGrant.Section" />
                                <button class="btn btn-success btn-sm" type="submit">
                                    Open @friend.DisplayName @incomingGrant.Section (@incomingGrant.AccessLevel)
                                </button>
                            </form>
                        }
                    </div>

                    <div class="mt-3">
                        @foreach (var grant in grants.Where(x => x.GranteeUserId == friend.Id))
                        {
                            <form asp-action="RevokeAccess" method="post" class="d-inline-block me-2 mb-2">
                                <input type="hidden" name="id" value="@grant.Id" />
                                <button class="btn btn-outline-secondary btn-sm" type="submit">
                                    @grant.Section: @grant.AccessLevel ×
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
