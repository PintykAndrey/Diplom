@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@using Diplom.Models.ViewModels

@{
    ViewData["Title"] = @Localizer["Tools"].Value;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-gradient">@Localizer["Tools Management"]</h2>
            <p class="text-muted mb-0">@Localizer["Choose a section to manage system tools and settings"]</p>
        </div>
    </div>

    <div class="row">
        <partial name="_SectionCard" model='new SectionCardModel {
            Icon = "bi-book",
            Title = @Localizer["Encyclopedia"].Value,
            Description = @Localizer["Manage reference data: operations, seeds, fertilizers, and other field materials"].Value,
            Url = @Url.Action("Encyclopedia", "Tools"),
            ButtonText = @Localizer["Encyclopedia"].Value,
            Color = "primary"
        }' />

        <partial name="_SectionCard" model='new SectionCardModel {
            Icon = "bi-translate",
            Title = @Localizer["Dictionary"].Value,
            Description = @Localizer["Manage translations and localization data for different languages"].Value,
            Url = @Url.Action("Vocabulary", "Navigation"),
            ButtonText = @Localizer["Dictionary"].Value,
            Color = "success"
        }' />

        <partial name="_SectionCard" model='new SectionCardModel {
            Icon = "bi-archive",
            Title = @Localizer["Archive"].Value,
            Description = @Localizer["Manage archived fields: view details, restore, or permanently delete"].Value,
            Url = @Url.Action("Archive", "Navigation"),
            ButtonText = @Localizer["Archive"].Value,
            Color = "danger"
        }' />
    </div>

</div>
