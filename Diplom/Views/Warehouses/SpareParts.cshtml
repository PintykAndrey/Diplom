@model List<Diplom.Models.Warehouses.MaterialLogModel>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer



@{

    ViewData["Title"] = Localizer["Spare Parts"];

    int newIndex = Model.Count;

}



<h2 class="text-center">@Localizer["Spare Parts Warehouse"]</h2>



<form asp-action="Save" asp-controller="Warehouses" method="post">



    <input type="hidden" name="category" value="SpareParts" />



    <table class="table table-bordered text-center">



        <thead>

            <tr>

                <th>@Localizer["No."]</th>

                <th>@Localizer["Date"]</th>

                <th>@Localizer["Name"]</th>

                <th>@Localizer["Unit"]</th>

                <th>@Localizer["Quantity"]</th>

                <th>@Localizer["Price"]</th>

                <th>@Localizer["Sum"]</th>

            </tr>

        </thead>



        <tbody>

            @for (int i = 0; i < Model.Count; i++)

            {

                <tr>

                    <td>@(i + 1)</td>



                    <td>

                        @Model[i].Date.ToLocalTime().ToString("dd.MM.yyyy")

                        <input type="hidden" name="models[@i].Id" value="@Model[i].Id" />

                    </td>



                    <td><input name="models[@i].Name" value="@Model[i].Name" class="form-control" required /></td>

                    <td>

                        <select name="models[@i].Unit" class="form-select form-select-sm" required>

                            <option value="kg" selected="@(Model[i].Unit == "kg")">@Localizer["kg"]</option>

                            <option value="pcs" selected="@(Model[i].Unit == "pcs")">@Localizer["pcs"]</option>

                        </select>

                    </td>

                    <td><input type="text" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" name="models[@i].Quantity" value="@Model[i].Quantity"
                            class="form-control" required /></td>

                    <td><input type="text" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" name="models[@i].Price" value="@Model[i].Price"
                            class="form-control" required /></td>



                    <td>@(Model[i].Sum?.ToString("0.00"))</td>

                </tr>

            }

        </tbody>



        <tfoot>

            <tr>

                <td>+</td>

                <td>@DateTime.Now.ToString("dd.MM.yyyy")</td>



                <td><input name="models[@newIndex].Name" class="form-control" /></td>

                <td>

                    <select name="models[@newIndex].Unit" class="form-select form-select-sm" required>

                        <option value="kg">@Localizer["kg"]</option>

                        <option value="pcs">@Localizer["pcs"]</option>

                    </select>

                </td>

                <td><input type="text" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" name="models[@newIndex].Quantity" class="form-control"
                        required /></td>

                <td><input type="text" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" name="models[@newIndex].Price" class="form-control"
                        required /></td>

                <td>—</td>

            </tr>

        </tfoot>



    </table>



    <div class="form-actions">

        <button type="submit" class="btn btn-primary btn-save">@Localizer["Save"]</button>

    </div>



</form>


